generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MemberRole {
  admin
  member
  viewer
}

enum ChannelStatus {
  connected
  disconnected
  pending
  error
}

enum ChannelType {
  whatsapp
  telegram
  slack
  discord
  instagram
  facebook
  line
  signal
  teams
  matrix
  web
  wechat_work
  whatsapp_business
  wechat_personal
}

enum MessageRole {
  user
  assistant
}

enum EndUserStatus {
  allowed
  blocked
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id        String     @id
  slug      String     @unique
  name      String
  settings  Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  members       Member[]
  sessions      Session[]
  channels      Channel[]
  endUsers      EndUser[]
  auditLogs     AuditLog[]
  aiBackends    AiBackend[]
  modelProviders ModelProvider[]
  agentTemplateVersions AgentTemplateVersion[]

  @@map("tenants")
}

/// Internal staff who manage the bot (owner/admin/viewers).
model Member {
  id           String     @id
  tenantId     String     @map("tenant_id")
  email        String
  name         String
  passwordHash String     @map("password_hash")
  role         MemberRole @default(member)
  isActive     Boolean    @default(true) @map("is_active")
  lastActiveAt DateTime?  @map("last_active_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  Session[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("members")
}

model Session {
  id        String   @id
  memberId  String   @map("member_id")
  tenantId  String   @map("tenant_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([tenantId])
  @@map("sessions")
}

model Channel {
  id        String        @id
  tenantId  String        @map("tenant_id")
  agentTemplateId String? @map("agent_template_id")
  agentTemplateVersionId String? @map("agent_template_version_id")
  type      ChannelType
  name      String
  status    ChannelStatus @default(disconnected)
  config    Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentTemplate AiBackend?     @relation("ChannelAgentTemplate", fields: [agentTemplateId], references: [id], onDelete: SetNull)
  agentTemplateVersion AgentTemplateVersion? @relation("ChannelAgentTemplateVersion", fields: [agentTemplateVersionId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  endUsers      EndUser[]

  @@index([tenantId])
  @@index([agentTemplateId])
  @@index([agentTemplateVersionId])
  @@map("channels")
}

/// External users who chat with the bot via social channels.
/// Identified by (tenantId, channelId, externalId) — the platform's user ID.
/// Can be anonymous (no name/email) until the bot or owner enriches the record.
model EndUser {
  id         String        @id
  tenantId   String        @map("tenant_id")
  channelId  String        @map("channel_id")
  externalId String        @map("external_id") // platform-native user ID
  name       String?
  email      String?
  metadata   Json          @default("{}")
  status     EndUserStatus @default(allowed)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  /// When set, this EndUser defers to the primary EndUser for cross-channel identity.
  linkedTo      String?   @map("linked_to")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel         Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  linkedPrimary   EndUser?       @relation("EndUserLink", fields: [linkedTo], references: [id], onDelete: SetNull)
  linkedFrom      EndUser[]      @relation("EndUserLink")
  conversations   Conversation[]
  activeBackends  EndUserBackend[]
  linkCodes       LinkCode[]

  @@unique([tenantId, channelId, externalId])
  @@index([tenantId])
  @@map("end_users")
}

/// Many-to-many join: which AI backends an end-user has active in their session.
model EndUserBackend {
  endUserId String   @map("end_user_id")
  backendId String   @map("backend_id")
  addedAt   DateTime @default(now()) @map("added_at")

  endUser   EndUser   @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  backend   AiBackend @relation(fields: [backendId], references: [id], onDelete: Cascade)

  @@id([endUserId, backendId])
  @@index([endUserId])
  @@index([backendId])
  @@map("end_user_backends")
}

model Conversation {
  id        String   @id
  tenantId  String   @map("tenant_id")
  channelId String   @map("channel_id")
  endUserId String   @map("end_user_id")
  backendId String?  @map("backend_id")
  agentTemplateVersionId String? @map("agent_template_version_id")
  modelProviderId String? @map("model_provider_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  channel  Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  endUser  EndUser    @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  backend  AiBackend? @relation(fields: [backendId], references: [id], onDelete: SetNull)
  agentTemplateVersion AgentTemplateVersion? @relation(fields: [agentTemplateVersionId], references: [id], onDelete: SetNull)
  modelProvider ModelProvider? @relation(fields: [modelProviderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([tenantId])
  @@index([endUserId])
  @@index([agentTemplateVersionId])
  @@map("conversations")
}

model Message {
  id             String      @id
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  /// Which AI backend generated this assistant message (null for user messages & ClawScale agent)
  backendId      String?     @map("backend_id")
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  backend      AiBackend?   @relation(fields: [backendId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("messages")
}

/// LLM provider account shared by one or more agent templates.
model ModelProvider {
  id        String   @id
  tenantId  String   @map("tenant_id")
  name      String
  provider  String
  baseUrl   String?  @map("base_url")
  apiKey    String?  @map("api_key")
  models    Json     @default("[]")
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentTemplates AiBackend[]
  conversations Conversation[]

  @@index([tenantId])
  @@map("model_providers")
}

/// Admin-configured AI providers. End-users pick one at the start of a conversation.
/// Many-to-many with EndUser (via selectedBackend) and Conversation (via backendId).
model AiBackend {
  id        String   @id
  tenantId  String   @map("tenant_id")
  modelProviderId String? @map("model_provider_id")
  /// Human-readable name shown to end-users in the selection menu
  name      String
  /// Provider type: openai | anthropic | openrouter | pulse | openclaw | custom
  type      String
  /// Provider-specific config: { apiKey?, model?, baseUrl?, pulseApiUrl?, openClawUrl? }
  config    Json     @default("{}")
  runtimeType String  @default("openclaw") @map("runtime_type")
  skills      Json    @default("[]")
  workspace   Json    @default("[]")
  knowledgeBase Json  @default("[]") @map("knowledge_base")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// True for the built-in ClawScale default agent (one per tenant, cannot be deleted)
  isDefault     Boolean  @default(false) @map("is_default")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelProvider ModelProvider? @relation(fields: [modelProviderId], references: [id], onDelete: SetNull)
  channels      Channel[]      @relation("ChannelAgentTemplate")
  versions      AgentTemplateVersion[]
  endUsers      EndUserBackend[]
  conversations Conversation[]
  messages      Message[]

  @@index([tenantId])
  @@index([modelProviderId])
  @@map("ai_backends")
}

model AgentTemplateVersion {
  id        String   @id
  tenantId  String   @map("tenant_id")
  agentTemplateId String @map("agent_template_id")
  version   Int
  name      String
  snapshot  Json
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentTemplate AiBackend @relation(fields: [agentTemplateId], references: [id], onDelete: Cascade)
  channels      Channel[] @relation("ChannelAgentTemplateVersion")
  conversations Conversation[]

  @@unique([agentTemplateId, version])
  @@index([tenantId])
  @@index([agentTemplateId])
  @@map("agent_template_versions")
}

model AuditLog {
  id         String   @id
  tenantId   String   @map("tenant_id")
  memberId   String?  @map("member_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("audit_logs")
}

/// Short-lived codes for cross-channel account linking.
model LinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  tenantId  String   @map("tenant_id")
  endUserId String   @map("end_user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([code, used])
  @@map("link_codes")
}
