# ClawScale Environment Configuration
# Copy this file to .env and fill in values

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://clawscale:clawscale@localhost:5432/clawscale

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d


# ─── OpenClaw Bridge ───────────────────────────────────────────────────────────
# Path to the OpenClaw binary. When set, ClawScale starts one isolated
# OpenClaw gateway per tenantId/channelId/endUserId/backendId.
OPENCLAW_BIN=openclaw
# ClawScale spawns per-tenant OpenClaw gateway instances; their ports are
# assigned dynamically starting from this base.
OPENCLAW_PORT_BASE=19000
# Directory where isolated OpenClaw state/ and workspace/ data is stored
OPENCLAW_DATA_DIR=./data/tenants
# Optional command template. Placeholders: {profile}, {port}, {stateDir}, {workspaceDir}
# OPENCLAW_ARGS="--profile {profile} gateway --port {port}"
