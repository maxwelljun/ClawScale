{
  "name": "clawscale",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw, unlocked for your whole team — multi-tenant workspace layer",
  "scripts": {
    "dev": "pnpm --parallel -r --filter \"!@clawscale/cli-bridge\" dev",
    "dev:web": "pnpm --filter @clawscale/app dev:web",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @clawscale/app db:push",
    "db:migrate": "pnpm --filter @clawscale/app db:migrate",
    "db:studio": "pnpm --filter @clawscale/app db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
